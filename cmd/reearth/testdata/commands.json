[
  {
    "path": "reearth",
    "usage": "reearth [flags]",
    "short": "Work with Re:Earth from the command line",
    "runnable": false,
    "flags": [
      {
        "name": "account",
        "type": "string",
        "usage": "Account to use for this command"
      },
      {
        "name": "debug",
        "type": "bool",
        "usage": "Print HTTP traces to stderr (secrets masked)"
      },
      {
        "name": "jq",
        "type": "string",
        "usage": "Filter JSON output with a jq expression (implies --json)"
      },
      {
        "name": "json",
        "type": "string",
        "usage": "Output JSON; optionally select fields: --json=id,name"
      },
      {
        "name": "no-color",
        "type": "bool",
        "usage": "Disable colors"
      },
      {
        "name": "no-input",
        "type": "bool",
        "usage": "Never prompt; fail if input is required"
      },
      {
        "name": "output",
        "shorthand": "o",
        "type": "string",
        "usage": "Output format: table|plain|json|yaml|ndjson"
      },
      {
        "name": "quiet",
        "shorthand": "q",
        "type": "bool",
        "usage": "Only print data, warnings and errors"
      },
      {
        "name": "version",
        "shorthand": "v",
        "type": "bool",
        "usage": "version for reearth"
      },
      {
        "name": "yes",
        "shorthand": "y",
        "type": "bool",
        "usage": "Skip confirmation prompts"
      }
    ]
  },
